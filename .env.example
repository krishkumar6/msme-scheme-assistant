# Groq (main answer model). Free key from console.groq.com
GROQ_API_KEY=
# See which models your key can use: python scripts/list_models.py groq
NABARD_QA_GROQ_MODEL=openai/gpt-oss-120b

# Gemini (backup for Groq + long-context Deep mode). Free key from aistudio.google.com
GEMINI_API_KEY=
# See which models your key can use: python scripts/list_models.py gemini
NABARD_QA_GEMINI_MODEL=gemini-3.6-flash

# Providers tried in this order; the next one answers if the previous fails or is rate-limited.
# Add ",local" to fall back to the fine-tuned model (scripts/serve_local_model.ps1).
NABARD_QA_LLM_CHAIN=groq,gemini
# Deep mode (UI "Mode: Deep", CLI --deep): this many passages, sent to this provider first
NABARD_QA_DEEP_K=40
NABARD_QA_DEEP_PROVIDER=gemini

# Generation. Provider: auto | groq | gemini | local | extractive
# auto = every provider with a key, in NABARD_QA_LLM_CHAIN order, then quoted extracts.
# With no key at all the app still runs and answers with quoted extracts.
NABARD_QA_LLM_PROVIDER=auto

# Local fine-tuned model (training/finetune_lora.py) behind an OpenAI-compatible server
NABARD_QA_LOCAL_BASE_URL=http://localhost:8001/v1
NABARD_QA_LOCAL_MODEL=nabard-qa-lora

# Retrieval
NABARD_QA_FINAL_K=6
NABARD_QA_RELEVANCE_GATE=0.0
NABARD_QA_ADAPTER_ENABLED=true

# API. The admin token enables POST /api/admin/train-adapter
NABARD_QA_ADMIN_TOKEN=change-me
NABARD_QA_LOG_LEVEL=INFO
